# Copy to sidecar/.env and fill in. .env is gitignored - never commit the key.
#
# Get a key from the Developer Admin Portal:
#   https://physiology.presagetech.com/auth/login
# Or let the SmartSpectra MCP server fetch it from your account for you.
PRESAGE_API_KEY=

# Loopback port the Flutter web app connects to.
SIDECAR_PORT=8787

# Length of one casing, in milliseconds. Presage needs a sustained look before
# it can produce HRV, so don't drop this much below 20s.
CASING_DURATION_MS=30000

# "smartspectra" (default) or "mock". The server falls back to mock on its own
# if the key is missing or this platform has no native runtime.
SIDECAR_SOURCE=smartspectra

# Mock scenario when SIDECAR_SOURCE=mock: calm | agitated | settling | noisy
MOCK_SCENARIO=settling

# ---------------------------------------------------------------- Auth0 bridge
# Optional. Without these the sidecar still measures composure; it just cannot
# mint Firebase tokens, and the app runs unauthenticated.
#
# Auth0 tenant domain, e.g. dev-abc123.us.auth0.com
AUTH0_DOMAIN=

# Optional API identifier. If set, the id_token's `aud` must match it.
AUTH0_AUDIENCE=

# Firebase Admin service account JSON. Generate in Firebase console ->
# Project settings -> Service accounts. This is a PRIVATE KEY - it is
# gitignored, keep it that way.
FIREBASE_SERVICE_ACCOUNT=./serviceAccountKey.json

# ------------------------------------------------------------------- Gemini
# Powers the conversation after a reading. Optional: without it the verdict
# still works, there is just no conversation.
# Key from https://aistudio.google.com/apikey
# NOTE: this stays server-side. A key in the Flutter web bundle is public.
GEMINI_API_KEY=
