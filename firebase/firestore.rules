rules_version = '2';

// Mastermind security rules.
//
// Identity comes from Auth0, exchanged for a Firebase custom token by the
// sidecar, so request.auth.uid IS the Auth0 `sub`. Every document lives under
// users/{uid} and nothing is readable across users.
//
// Deploy:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // The attempts log is the sensitive part of this product: it records when
    // someone reached for something and what physiological state they were in.
    // It is append-only by design — being able to quietly delete the evidence
    // of a bad night would defeat the point of a commitment device, and being
    // able to edit it after the fact would make the history worthless.
    function isValidAttempt() {
      let d = request.resource.data;
      return d.keys().hasAll(['jobId', 'verdict', 'measuredAt'])
          && d.verdict in ['green', 'amber', 'red', 'inconclusive']
          && (d.composure == null || (d.composure is int && d.composure >= 0 && d.composure <= 100));
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /jobs/{jobId} {
        allow read, write: if isOwner(uid);
      }

      match /attempts/{attemptId} {
        allow read:   if isOwner(uid);
        allow create: if isOwner(uid) && isValidAttempt();
        // Immutable once written.
        allow update, delete: if false;
      }
    }

    // Anything not matched above is denied. Stated explicitly rather than left
    // to the default, so a future `match` added in the wrong place is obvious.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
